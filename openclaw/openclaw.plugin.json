{
  "id": "xbot",
  "name": "Xbot",
  "channels": ["xbot"],
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "enabled": { "type": "boolean" },
      "xchatbotApiBaseUrl": {
        "type": "string",
        "description": "xchatbot Worker origin, e.g. https://xbot.example.com"
      },
      "xchatbotToken": {
        "type": "string",
        "description": "Bearer token, same as xchatbot XBOT_CHANNEL_GATEWAY_TOKEN / AGENT_BRIDGE_TOKEN"
      },
      "wsEnabled": {
        "type": "boolean",
        "description": "Connect to the xchatbot WebSocket mailbox (default true)"
      },
      "wsBrain": {
        "type": "string",
        "description": "xchatbot brain key for the mailbox (default openclaw)"
      },
      "mediaRoots": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Local image files in replies are uploaded only from these directories (default ~/.openclaw/workspace)"
      },
      "phoneHost": {
        "type": "string",
        "description": "ssh alias of the cloud phone box; /tmp/<name>.jpg|png in replies is fetched over ssh then uploaded (empty = off)"
      },
      "botName": {
        "type": "string",
        "description": "Display name"
      },
      "accounts": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" }
          }
        }
      }
    }
  },
  "channelConfigs": {
    "xbot": {
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "xchatbotApiBaseUrl": { "type": "string" },
          "xchatbotToken": { "type": "string" },
          "wsEnabled": { "type": "boolean" },
          "wsBrain": { "type": "string" },
          "mediaRoots": { "type": "array", "items": { "type": "string" } },
          "phoneHost": { "type": "string" },
          "botName": { "type": "string" },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
